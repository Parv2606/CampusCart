{
  "name": "campuscart",
  "version": "1.0.0",
  "description": "CampusCart - Campus Peer-to-Peer Student Marketplace with MongoDB Atlas",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "view:db": "npm --prefix server run view:db",
    "clean:ports": "powershell -Command \"Get-Process -Id (Get-NetTCPConnection -LocalPort 5000,5173 -ErrorAction SilentlyContinue).OwningProcess -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
