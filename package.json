{
  "name": "campuscart",
  "version": "1.0.0",
  "description": "CampusCart - Campus Peer-to-Peer Student Marketplace with MongoDB Atlas",
  "private": true,
  "scripts": {
    "build": "npm --prefix client run build",
    "prestart": "node clean-ports.js",
    "start": "npm run dev",
    "start:prod": "node server/server.js",
    "install:all": "npm install --include=dev && npm --prefix server install --include=dev && npm --prefix client install --include=dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "predev": "node clean-ports.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "view:db": "npm --prefix server run view:db",
    "clean:ports": "node clean-ports.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
